{
  "name": "@verne-software/sdk",
  "version": "1.5.0",
  "description": "Official Node.js and TypeScript SDK for Nautilus by Verne Software: sign-in and users, webhook delivery, cron jobs and Telegram sign-in. Hosted in France.",
  "license": "MIT",
  "author": "Verne Software",
  "homepage": "https://vernesoft.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verne-Software/vrn-sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/Verne-Software/vrn-sdk-node/issues"
  },
  "keywords": [
    "nautilus",
    "verne",
    "sdk",
    "authentication",
    "webhooks",
    "cron",
    "telegram-login",
    "jwt",
    "ory-kratos",
    "svix",
    "gdpr",
    "eu-hosted"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:single": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
